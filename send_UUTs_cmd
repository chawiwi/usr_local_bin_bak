#!/usr/bin/env python3

import os
import subprocess
import re
import concurrent.futures

def get_user_input():
    sn_list = []
    while True:
        sn = input("\n Enter SNs to send command to UUTs (enter twice when finish): \n")
        if not sn:
            break
        sn_list.append(sn)
    return sn_list

def check_sn_config(sn):
    config_path = f"/WIN/T6UB/response/config/{sn}.txt"
    if not os.path.exists(config_path):
        print(f"Configuration file for {sn} does not exist.")
        return None

    with open(config_path, 'r') as file:
        config_data = file.read()

    location_match = re.search(r'LOCATION=(\S+)', config_data)
    eth0_match = re.search(r'ETH0=(\S+)', config_data)

    if not location_match or not eth0_match:
        print(f"Required data not found in {sn}.txt.")
        return None

    location = location_match.group(1)
    eth0 = eth0_match.group(1).split(',')[0]  # Get the MAC address

    return location, eth0

def find_ip(mac_address):
    try:
        ip = subprocess.check_output(["find_ip", mac_address]).decode().strip()
        if not ip:
            raise ValueError("No IP found.")
        return ip
    except subprocess.CalledProcessError:
        print(f"Failed to find IP for MAC address: {mac_address}")
        return None

def run_command_on_ip(ip, command, os_type):
    if os_type == 'linux':
        ssh_command = f'sshpass -p root ssh -o StrictHostKeyChecking=no root@{ip} "{command}"'
    elif os_type == 'windows':
        # Use a properly formatted command for Windows paths
        ssh_command = f'sshpass -p A123456a ssh -o StrictHostKeyChecking=no Administrator@{ip} {command}'
    else:
        return f"Unknown OS type: {os_type}"

    try:
        subprocess.check_call(ssh_command, shell=True)
        return f"Command executed successfully on {ip}."
    except subprocess.CalledProcessError:
        return f"Failed to execute command on {ip}."

def process_sn(sn, command, os_type):
    config = check_sn_config(sn)
    if not config:
        return f"Configuration failed for SN: {sn}"

    location, mac_address = config
    print(f"SN: {sn}, LOCATION: {location}, MAC: {mac_address}")

    ip = find_ip(mac_address)
    if not ip:
        return f"Failed to find IP for MAC: {mac_address}"

    return run_command_on_ip(ip, command, os_type)

def main():
    os_type = input("Please enter OS type (linux/windows): ").strip().lower()
    sn_list = get_user_input()
    command = input("Please enter command to execute on unit: ")

    with concurrent.futures.ThreadPoolExecutor() as executor:
        futures = {executor.submit(process_sn, sn, command, os_type): sn for sn in sn_list}

        for future in concurrent.futures.as_completed(futures):
            result = future.result()
            print(result)

if __name__ == "__main__":
    main()
