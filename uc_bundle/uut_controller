def input_sn():
    pn_list = []
    bmc_ip_list  = []
    eth_ip_list = []

    if len(sys.argv) > 1:
        sn = sys.argv[1]
    else:
        sn = input(Fore.MAGENTA + "Please enter serial number of the servers:\n" + Style.RESET_ALL).strip().lower()
    while len(sn) != 0:
        if 'p' in sn or 'P' in sn:
            sn_cleaned= re.sub(r'\x1B\[200~|\x1B\[201~', '', sn)
            pn_list.append(sn_cleaned)
            if len(sys.argv) > 1:
                break
            sn = input().strip().lower()
        else:
            print("The information is not a serial number of servers")
            sn = input().strip().lower()

    choice = input(Fore.MAGENTA +"Enter your choice (99 for menu options): "+ Style.RESET_ALL)
    time.sleep(1)
    cp_ip_list,get_ip,macs_list,model_list,test_loc = find_uut_ip(pn_list,"both")
    index = 0
    for each in get_ip:
        if index%2 == 0:
            bmc_ip_list.append(each)
        else:
            eth_ip_list.append(each)
        index += 1
    return choice,bmc_ip_list,eth_ip_list,cp_ip_list,macs_list,pn_list,model_list,test_loc
