def format_mac_address(mac,key):
    if key == "normal_format":
        return ':'.join(mac[i:i + 2].lower() for i in range(0, len(mac), 2))
    elif key == "custom_ipxe_format":
        return '-'.join(mac[i:i + 2].lower() for i in range(0, len(mac), 2))
def get_dhcp_list():
    dhcp_lease_list = "dhcp-lease-list | grep -A9999 '=' | awk '{print $1, $2}'"
    valid_list = getresult(dhcp_lease_list)
    valid_dict = {}
    for line in valid_list.strip().split('\n'):
        fields = line.split()
        if len(fields) >= 2:
            mac = fields[0]
            ip = fields[1]
            valid_dict[mac] = ip
    return valid_dict
def find_uut_ip(pn_list,addr_port):
    ip = []
    cp_ip = []
    models = []
    location = []
    with ThreadPoolExecutor(max_workers=2) as executor:
        futures_mac_list = executor.submit(api_calling_threaded,pn_list)
        futures_dhcp_map = executor.submit(get_dhcp_list)
        #waiting for the result for threads
        mac_list = futures_mac_list.result()
        dhcp_map = futures_dhcp_map.result()

    uut_ip_cp,uut_ip_bmc,uut_ip_eth0 = '','',''
    for uut in mac_list:
        bmcmac_format = format_mac_address(uut.bmc_mac,"normal_format")
        ethmac_format = format_mac_address(uut.eth0_mac,"normal_format")
        models.append(uut.model)
        location.append(uut.test_loc)
        if uut.eth9_mac != None:
            eth9_mac_format = format_mac_address(uut.eth9_mac,"normal_format")
            if eth9_mac_format in dhcp_map:
                uut_ip_cp = dhcp_map[eth9_mac_format]
            if uut_ip_cp== '':
                cp_ip.append('None')
            else:
                cp_ip.append(uut_ip_cp.strip())
        else:
            cp_ip.append('None')
        if addr_port in ("bmc", "both"):
            if bmcmac_format in dhcp_map:
                uut_ip_bmc = dhcp_map[bmcmac_format]
            if uut_ip_bmc == '':
                ip.append('None')
            else:
                ip.append(uut_ip_bmc.strip())
        if addr_port in ("eth0", "both"):
            if ethmac_format in dhcp_map:
                uut_ip_eth0 = dhcp_map[ethmac_format]
            if uut_ip_eth0 == '':
                ip.append('None')
            else:
                ip.append(uut_ip_eth0.strip())
    return cp_ip,ip,mac_list,models,location
def ping_ip(uut_ip):
    cmd = f"ping -c 1 {uut_ip} > /dev/null"
    if uut_ip == 'None':
        return "No IP"
    elif os.system(cmd) == 0:
        return "Success"
    else: # ping fail
        return "Fail"

def process_raw_data(raw_data1, raw_data2, raw_data3):
    if not raw_data1 or not raw_data2 or not raw_data3:
        print('Error: Missing required raw data.')
        return None, None, None

    cmd_process0 = f"echo -e \"{raw_data1}\" | awk '{{ print $3$4$5$6 $7$8$9 }}' | xxd -ps -r"
    cmd_process1 = f"echo -e \"{raw_data2}\" | awk '{{ print $3$4$5$6$7$8$9$10$11 }}' | xxd -ps -r"
    cmd_process2 = f"echo -e \"{raw_data3}\" | awk '{{ print $3$4$5$6$7$8$9$10$11 }}' | xxd -ps -r"

    try:
        result0, result1, result2 = getresult(cmd_process0), getresult(cmd_process1), getresult(cmd_process2)
        return result0,result1,result2
    except Exception as e:
        print(f"Error: {e}")
        return None, None, None
