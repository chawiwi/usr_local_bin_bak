def getresult(arg1):
    p = subprocess.Popen(arg1, stdout=subprocess.PIPE, shell=True, text=True)
    (text, err) = p.communicate()
    return text
def ac_uut(ip_list):
    for uut in ip_list:
        cmd_uut_off = f"ipmitool -H {uut} -U admin -P admin power off"
        cmd_uut_on = f"ipmitool -H {uut} -U admin -P admin power on"
        mesg = getresult(cmd_uut_off)
        if "Down/Off" in mesg:
            print("-------------------RESULT------------------------------")
            print(Fore.YELLOW + f"{uut} is turning off" + Style.RESET_ALL)
            print(Fore.MAGENTA + f"Sleeping time is for 15 seconds" + Style.RESET_ALL)
            time.sleep(15)
            mesg=getresult(cmd_uut_on)
            if "Up/On" in mesg:
                print(Fore.GREEN + f"{uut} is turning back on" + Style.RESET_ALL)
            else:
                print(f"Error mesg:{mesg}")
        else:
            display_error(mesg)
