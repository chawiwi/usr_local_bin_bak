def query_uut_info(url, sn):
    API_Type = "CONFIG"
    API_Station = "QUERY"
    client = Client(url)
    response = client.service.SendRequest(API_Station,sn,API_Type)
    response_text = str(response).replace("'", "\"").replace("None", "null")
    response_dict = json.loads(response_text)
    model,bmc_mac, eth0_mac, mbsn, eth9_mac, test_loc="Unknown","Unknown","Unknown","Unknown","Unknown","Unknown"
    global red_fish,type_uut
    type_uut = "None GB200"
    bios_ver = "unknown"
    for config in response_dict['Configs']['Config']:
        if config['Parameter'] == 'MODEL':
            model = config['Value']
            continue
        elif config['Parameter'] == 'MBSN':
            mbsn = config['Value']
            continue
        elif config['Parameter'] == 'BMCMAC':
            bmc_mac = config['Value']
            continue
        elif config['Parameter'] == 'BIOS':
            bios_ver = config['Value'].split(',')[0].strip()
            continue
        if 'T6K' in model:
            if config['Parameter'] == 'ETH1':
                eth9_mac = config['Value'].split(',')[0]
        elif 'T6H' in model:
            if config['Parameter'] == 'ETH2':
                eth9_mac = config['Value'].split(',')[0]
        elif 'T6G' in model:
            if config['Parameter'] == 'ETH3':
                eth9_mac = config['Value'].split(',')[0]
        elif 'T6T' in model:
            if '0ACTV' in bios_ver:
                type_uut = "NV Switch"
                if config['Parameter'] == 'ETH0':
                    eth0_mac = config['Value'].split(',')[0]
                    continue
                elif config['Parameter'] == 'ETH1':
                    eth9_mac = config['Value'].split(',')[0]
                    continue
            else:
                red_fish = True
                type_uut = "Compute Tray"
                if config['Parameter'] == 'ETH1':
                    eth0_mac =  config['Value'].split(',')[0]
                    continue
                elif config['Parameter'] == 'ETH0':
                    eth9_mac = config['Value'].split(',')[0]
                    continue
        else:
            if config['Parameter'] == 'ETH0':
                eth0_mac = config['Value'].split(',')[0]
                continue
            elif config['Parameter'] == 'ETH9':
                eth9_mac = config['Value'].split(',')[0]
                continue
        if config['Parameter'] == 'TESTLOC':
                test_loc = config['Value']
                continue
    return UUTInfo(model=model,serial_number=sn, bmc_mac=bmc_mac, eth0_mac=eth0_mac, mbsn=mbsn, eth9_mac=eth9_mac, test_loc=test_loc)

def api_calling_threaded(sns):
    stop_event = threading.Event()
    t = threading.Thread(target=waiting_animation, args=(stop_event,))
    t.start()
    api_url = 'http://192.168.66.20/AMA_L10/AMAService.svc?singleWsdl'
    uut_info_list = []
    for sn in sns:
        uut_info_list.append(query_uut_info(api_url, sn))
    stop_event.set()
    t.join()
    return uut_info_list

def waiting_animation(stop_event):
    while not stop_event.is_set():
        for char in "|/-\\":
            sys.stdout.write(f'\rCall API Processing {char}')
            sys.stdout.flush()
            time.sleep(0.1)
    sys.stdout.write('\n')
    sys.stdout.write('\r' + ' ' * 25 + '\r')

