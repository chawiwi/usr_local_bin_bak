def check_in_mdaas(sf_sn, exp_station):
    sf_conf_file = "{0}/{1}.txt".format(win_response, sf_sn)
    if os.path.exists(sf_conf_file):
        station = getresult("cat {0} | grep -i 'station'".format(sf_conf_file))
        station = station.split("=")[1].strip()
        sendlog("{0} is in {1}".format(sf_sn, station))
        if station == exp_station: #  in MDAAS
            return True
        else:
            return False
    else:
        # SF config not exists
        return False



def adjust_config_station(sf_sn, local_sf_file,sf_conf_file, current_station, next_station):
    sendlog("{0} goto {1} station".format(sf_sn, next_station))
    cmd = f"sed -i 's/STATION={current_station}/STATION={next_station}/g' {local_sf_file}"
    logging.debug(cmd)
    os.system(cmd)
    os.system(f"cp {local_sf_file} {sf_conf_file}")
    os.system(f"rm -f {local_sf_file}")
    return 0

def goto_genconfig(sf_sn):
    sf_conf_file = "{0}/{1}.txt".format(win_response, sf_sn) # /WIN/Project/response/config/SN.txt
    local_sf_file = "{0}/{1}_SF.txt".format(working_dir, sf_sn) #/mdaas/SN_SF.txt
    os.system("cp {0} {1}".format(sf_conf_file, local_sf_file))
    if check_in_mdaas(sf_sn, station_list[1]):
        current_station = station_list[1]
    else:
        current_station = station_list[2]
    adjust_config_station(sf_sn, local_sf_file,sf_conf_file, current_station, station_list[0])
    return 0

def goto_next_station(sf_sn):
    sf_conf_file = "{0}/{1}.txt".format(win_response, sf_sn) # /WIN/Project/response/config/SN.txt
    local_sf_file = "{0}/{1}_SF.txt".format(working_dir, sf_sn) #/mdaas/SN_SF.txt
    os.system("cp {0} {1}".format(sf_conf_file, local_sf_file))
    
    if check_in_mdaas(sf_sn, station_list[0]): #Check for MDAASGENCONFIG
        current_station = station_list[0]
        next_station = station_list[2] # MDAAS_LINUX
        if is_cpu_Intel(sf_sn):
            next_station = station_list[1] #MDAAS_SHC
        adjust_config_station(sf_sn, local_sf_file,sf_conf_file, current_station, next_station)
        return 0
    elif check_in_mdaas(sf_sn, station_list[1]): #Check for MDAAS_SHC
        current_station = station_list[1]
        next_station = station_list[2] # MDAAS_LINUX
        adjust_config_station(sf_sn, local_sf_file,sf_conf_file, current_station, next_station)
        return 0
    elif check_in_mdaas(sf_sn, station_list[2]): #Check for MDAAS_LINUX
        current_station = station_list[2]
        next_station = station_list[3] # MDAAS_WIN
        adjust_config_station(sf_sn, local_sf_file,sf_conf_file, current_station, next_station)
        return 0
    elif check_in_mdaas(sf_sn, station_list[3]): #Check for MDAAS_WIN
        model = find_info(sf_sn,"PARTN")
        current_station = station_list[3]
        next_station = station_list[4] #FST
        if model == "C2189" or model == "C2789" or model == "C2398":
            next_station = station_list[5] # NETTEST
        adjust_config_station(sf_sn, local_sf_file,sf_conf_file, current_station, next_station)
        return 0
    else:
        sendlog("{0} is not in {1} station or {2} station ".format(sf_sn, station_list[1], station_list[2]))
        
        os.system("rm -f {0}".format(local_sf_file))
        return 1

