ESC_GREEN="\033[32m"
ESC_RED="\033[31m"
ESC_YELLOW_F="\033[33;1m"
ESC_YELLOW="\033[33m"
ESC_PINK="\033[35m"
ESC_LBLUE="\033[36m"
ESC_OFF="\033[0m"

