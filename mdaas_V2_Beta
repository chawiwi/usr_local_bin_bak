def get_rm_ip(sf_sn):
    sf_conf_file = "{0}/{1}.txt".format(win_response, sf_sn)
    if os.path.exists(sf_conf_file):
        location = getresult("cat {0} | grep -i 'LOCATION'".format(sf_conf_file)).split("=")[1].strip()
        if "T6G" in project.upper(): #20231026 David add: T6G/T6H have 2 RM
            if location >= "F27":
                RACK_MOUNT_MAC = getresult("cat {0} | grep -i 'RACK_MOUNT1_MAC1'".format(sf_conf_file))
            elif location <= "F21":
                RACK_MOUNT_MAC = getresult("cat {0} | grep -i 'RACK_MOUNT_MAC1'".format(sf_conf_file))

        elif "T6H" in project.upper(): #20240625 Jenny add: H100/V710 have 2 RM, but Supernova have 1 RM.
            rackpn = getresult("cat {0} | grep -i 'RACKPN'".format(sf_conf_file))
            #RACKPN 1L15U9Z0060,1L15U9Z006N is Supernova SKU.
            if rackpn not in ["1L15U9Z0060","1L15U9Z006N"]:
                if location >= "F27":
                    RACK_MOUNT_MAC = getresult("cat {0} | grep -i 'RACK_MOUNT1_MAC1'".format(sf_conf_file))
                elif location <= "F20":
                    RACK_MOUNT_MAC = getresult("cat {0} | grep -i 'RACK_MOUNT_MAC1'".format(sf_conf_file))
            else:
                #Supernova SKU
                RACK_MOUNT_MAC = getresult("cat {0} | grep -i 'RACK_MOUNT_MAC1'".format(sf_conf_file))
        else:
            RACK_MOUNT_MAC = getresult("cat {0} | grep -i 'RACK_MOUNT_MAC1'".format(sf_conf_file))
        RACK_MOUNT_MAC = RACK_MOUNT_MAC.split("=")[1].strip()
        RACK_MOUNT_MAC_TRANS=(RACK_MOUNT_MAC[:2]+':'+RACK_MOUNT_MAC[2:4]+':'+RACK_MOUNT_MAC[4:6]+':'+RACK_MOUNT_MAC[6:8]+':'+RACK_MOUNT_MAC[8:10]+':'+RACK_MOUNT_MAC[10:12])
        RACK_MOUNT_MAC_TRANS = RACK_MOUNT_MAC_TRANS.lower()

        search_ip_cmd = "grep -i -B8 -A1 {0} /var/lib/dhcpd/dhcpd.leases | grep lease | sort | uniq".format(RACK_MOUNT_MAC_TRANS)
        ip = getresult(search_ip_cmd)
        if len(ip) >= 1:
            ip =  ip.strip().split("{")
            for line in ip:
                if line != "":
                    line = line.split(" ")[1]
                    log = "get_rm_ip  MAC = {0} IP ={1}".format(RACK_MOUNT_MAC_TRANS,line)
                    sendlog(log)

                    log = "Check RM Connection IP ={}".format(line)
                    cmd = "ping -c 3 {}".format(line)
                    if os.system(cmd) == 0:
                        sendlog(log)
                        return line
                    else:
                        continue
                else:
                    break
        return 1

def check_ping(ip_address):
    ping_cmd = ['ping', '-c', '3']
    ping_cmd.append(ip_address)
    try:
        subprocess.run(ping_cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True 
    except subprocess.CalledProcessError:
        return False  
